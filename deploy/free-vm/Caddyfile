{$DOMAIN} {
	encode gzip
	# Uploads are capped at 10 MB by the app; allow a little headroom.
	request_body {
		max_size 11MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# Metrics are for Prometheus only, not the public internet.
	respond /metrics 404
	reverse_proxy api:8000
	# Privacy: no access log.
	log {
		output discard
	}
}
