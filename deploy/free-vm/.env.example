# Your free subdomain, e.g. from https://www.duckdns.org (point it at the VM's public IP)
DOMAIN=docuchat.duckdns.org

# Option A - Groq free tier (fast, no GPU needed). Free key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Option B - fully self-hosted & unlimited (start with: docker compose --profile ollama up -d)
# then once:  docker compose exec ollama ollama pull llama3.2:3b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=llama3.2:3b

SESSION_TTL_SECONDS=7200
RATE_LIMIT_PER_MINUTE=30
