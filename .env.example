# Copy to .env and fill in. Never commit .env.
# Free key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Local alternative with Ollama (no key needed):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.2

# --- Accounts & payments ---
# Long random value; keeps sign-ins and session ownership valid across restarts.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PUBLIC_URL=http://localhost:8000
# Razorpay test keys (Dashboard -> Account & Settings -> API Keys, in Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email for sign-in links (optional locally - docker-compose sets DEV_LOGIN=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DocuChat <no-reply@example.com>
